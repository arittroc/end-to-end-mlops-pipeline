# =============================================================================
# Python
# =============================================================================

# Virtual environments — never commit these (can be 2+ GB)
house_price_env/
.venv/
venv/
env/
ENV/
.env/

# Compiled bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
MANIFEST
wheels/

# Unit test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
nosetests.xml
junit*.xml

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# =============================================================================
# Secrets & credentials — the most important section
# =============================================================================

# NEVER commit real credentials
.env
.env.*
!.env.example          # the template IS committed

# =============================================================================
# MLflow
# =============================================================================

# Local artifact cache (fetched from the tracking server at runtime)
mlflow-artifacts/
mlruns/

# MLflow SQLite fallback store (if tracking URI is ever changed to local)
mlflow.db

# =============================================================================
# ZenML
# =============================================================================

# ZenML local metadata store and configuration
# .zen/   → project-level config created by `zenml init` (inside project root)
# .zenml/ → home-directory global config, but sometimes written locally too
.zen/
.zenml/

# =============================================================================
# Jupyter
# =============================================================================

.ipynb_checkpoints/
*.ipynb_checkpoints
profile_default/
ipython_config.py

# =============================================================================
# Docker
# =============================================================================

# Local build artefacts (image tarballs etc.)
*.tar

# =============================================================================
# Data files — raw data is not source code
# =============================================================================

# Uncomment if you want to exclude large data files from the repo.
# If using DVC, commit the .dvc files instead of the raw data.
# data/
# *.csv
# *.zip
# *.parquet
# *.feather

# =============================================================================
# IDE & editor
# =============================================================================

# VS Code
.vscode/
*.code-workspace

# PyCharm / JetBrains
.idea/
*.iws
*.iml
*.ipr

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# Sublime Text
*.sublime-workspace
*.sublime-project

# =============================================================================
# Operating system
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# =============================================================================
# Logs & temporary files
# =============================================================================

*.log
*.tmp
*.temp
*.bak
*.orig

# =============================================================================
# Project-specific
# =============================================================================

# SSH keys that might accidentally land here
*.pem
*.key
id_rsa
id_ed25519

# Local notes / scratch files
scratch/
sandbox/
