# Enforce consistent line endings across platforms.
# All text files default to LF (Unix) so shell scripts are not corrupted
# when cloned on Windows machines.

# Default: normalise everything to LF on commit
* text=auto eol=lf

# Shell scripts MUST be LF — CRLF breaks bash execution on Linux/macOS
*.sh        text eol=lf

# Python source
*.py        text eol=lf

# Docker / config files
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.env       text eol=lf

# Documentation
*.md        text eol=lf
*.txt       text eol=lf

# Binary files — never modify line endings
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.pdf       binary
*.pkl       binary
*.joblib    binary
